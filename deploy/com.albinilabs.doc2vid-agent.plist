<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.albinilabs.doc2vid-agent</string>
  <key>ProgramArguments</key><array><string>/bin/sh</string><string>@ROOT@/deploy/agent-session.sh</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/doc2vid/agent.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/doc2vid/agent.log</string>
</dict>
</plist>
