<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.albinilabs.doc2vid</string>
  <key>ProgramArguments</key><array><string>@NODE@</string><string>@SERVER@/src/server.mjs</string></array>
  <key>WorkingDirectory</key><string>@SERVER@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/doc2vid/stdout.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/doc2vid/stderr.log</string>
</dict></plist>
